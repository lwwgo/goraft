.vscode/*
# Runtime artifacts (ignore data files only, not source directories)
/log/
/wal/*.wal
/snapshot/*.snap
/snap/*.snap
# Old demo/build outputs
demo/
output/
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
